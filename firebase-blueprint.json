{
  "entities": {
    "User": {
      "title": "User",
      "description": "A crew member of VESTA-11",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["Commander", "Lead Engineer"] },
        "displayName": { "type": "string" },
        "lastActive": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role"]
    },
    "Message": {
      "title": "Message",
      "description": "Subspace brain dump or communication",
      "type": "object",
      "properties": {
        "senderId": { "type": "string" },
        "content": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "type": { "type": "string", "enum": ["brain-dump", "poem", "alert"] },
        "analysis": { "type": "string" }
      },
      "required": ["senderId", "content", "timestamp"]
    },
    "Task": {
      "title": "Task",
      "description": "Ship maintenance or calibration task",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "completed"] },
        "assignedTo": { "type": "string" },
        "category": { "type": "string", "enum": ["Life Support", "Navigation", "Nuclear Heart", "Olive Grove"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "status", "category"]
    },
    "FusionPulse": {
      "title": "FusionPulse",
      "description": "Simultaneous connection event",
      "type": "object",
      "properties": {
        "participants": { "type": "array", "items": { "type": "string" } },
        "timestamp": { "type": "string", "format": "date-time" },
        "poem": { "type": "string" }
      },
      "required": ["participants", "timestamp"]
    },
    "FocusSession": {
      "title": "FocusSession",
      "description": "Shared ADHD focus session",
      "type": "object",
      "properties": {
        "active": { "type": "boolean" },
        "startTime": { "type": "string", "format": "date-time" },
        "participants": { "type": "array", "items": { "type": "string" } },
        "topic": { "type": "string" }
      },
      "required": ["active", "startTime"]
    },
    "Secret": {
      "title": "Secret",
      "description": "A decaying message with a half-life",
      "type": "object",
      "properties": {
        "senderId": { "type": "string" },
        "content": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "halfLifeHours": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "decayed", "unlocked"] }
      },
      "required": ["senderId", "content", "createdAt", "halfLifeHours"]
    },
    "Presence": {
      "title": "Presence",
      "description": "User online status and location",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "lastSeen": { "type": "string", "format": "date-time" },
        "location": {
          "type": "object",
          "properties": {
            "lat": { "type": "number" },
            "lng": { "type": "number" }
          }
        },
        "breathing": { "type": "boolean" }
      },
      "required": ["uid", "lastSeen"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile data"
    },
    "/messages/{messageId}": {
      "schema": "Message",
      "description": "Communication logs"
    },
    "/tasks/{taskId}": {
      "schema": "Task",
      "description": "Mission tasks"
    },
    "/pulses/{pulseId}": {
      "schema": "FusionPulse",
      "description": "Fusion event logs"
    },
    "/focus_sessions/{sessionId}": {
      "schema": "FocusSession",
      "description": "ADHD focus sessions"
    },
    "/secrets/{secretId}": {
      "schema": "Secret",
      "description": "Decaying secrets"
    },
    "/presence/{userId}": {
      "schema": "Presence",
      "description": "User presence and location"
    }
  }
}
