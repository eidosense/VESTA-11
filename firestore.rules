// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: users
// Fields:
//   - uid: string (required)
//   - email: string (required)
//   - role: string (required, 'Commander' | 'Lead Engineer')
//   - displayName: string
//   - lastActive: timestamp
//
// Collection: messages
// Fields:
//   - senderId: string (required)
//   - content: string (required)
//   - timestamp: timestamp (required)
//   - type: string ('brain-dump' | 'poem' | 'alert')
//   - analysis: string
//
// Collection: tasks
// Fields:
//   - title: string (required)
//   - status: string (required, 'pending' | 'completed')
//   - assignedTo: string
//   - category: string (required)
//   - createdAt: timestamp
//
// Collection: pulses
// Fields:
//   - participants: list (required)
//   - timestamp: timestamp (required)
//   - poem: string
//
// ===============================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getVesselId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.vesselId;
    }

    function isMember(vesselId) {
      return isAuthenticated() && 
             vesselId != null && 
             request.auth.uid in get(/databases/$(database)/documents/vessels/$(vesselId)).data.members;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.email == "arya@eidosense.com" && request.auth.token.email_verified == true);
    }

    // User Profiles
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId);
    }

    // Memories
    match /memories/{memoryId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.authorId == request.auth.uid;
    }

    // Vessels
    match /vessels/{vesselId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.members;
      allow create: if isAuthenticated() && request.resource.data.members.size() == 1 && request.resource.data.members[0] == request.auth.uid;
      allow update: if isAuthenticated() && 
                    resource.data.members.size() < 2 && 
                    request.resource.data.members.size() == 2 &&
                    resource.data.members[0] == request.resource.data.members[0];
    }

    // Invitations
    match /invitations/{tokenId} {
      allow read: if true; // Allow anyone to check if an invite is valid
      allow create: if isAuthenticated() && isMember(request.resource.data.vesselId);
      allow update: if true; // Allow marking as used
    }

    // Messages
    match /messages/{messageId} {
      allow read: if isMember(resource.data.vesselId);
      allow create: if isMember(request.resource.data.vesselId) && request.resource.data.senderId == request.auth.uid;
      allow update, delete: if isMember(resource.data.vesselId) && resource.data.senderId == request.auth.uid;
    }

    // Tasks
    match /tasks/{taskId} {
      allow read: if isMember(resource.data.vesselId);
      allow create, update, delete: if isMember(request.resource.data.vesselId || resource.data.vesselId);
    }

    // Fusion Pulses
    match /pulses/{pulseId} {
      allow read: if isMember(resource.data.vesselId);
      allow create: if isMember(request.resource.data.vesselId);
    }

    // Pulse Attempts
    match /pulse_attempts/{attemptId} {
      allow read, create: if isAuthenticated(); // These are transient, but could be scoped too
    }

    // Focus Sessions
    match /focus_sessions/{sessionId} {
      allow read: if isMember(resource.data.vesselId);
      allow create, update, delete: if isMember(request.resource.data.vesselId || resource.data.vesselId);
    }

    // Secrets
    match /secrets/{secretId} {
      allow read: if isMember(resource.data.vesselId);
      allow create: if isMember(request.resource.data.vesselId);
      allow update: if isMember(resource.data.vesselId);
    }

    // Archive Entries
    match /archive_entries/{entryId} {
      allow read: if isMember(resource.data.vesselId);
      allow create: if isMember(request.resource.data.vesselId);
      allow update: if isMember(resource.data.vesselId);
    }

    // Mission Logs
    match /missionLogs/{logId} {
      allow read: if isMember(resource.data.vesselId);
      allow create: if isMember(request.resource.data.vesselId) && request.resource.data.astronautId == request.auth.uid;
      allow update, delete: if isMember(resource.data.vesselId) && resource.data.astronautId == request.auth.uid;
    }

    // Memories
    match /memories/{memoryId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated();
    }

    // Timeline
    match /timeline/{eventId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }

    // Presence
    match /presence/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // Connection Test
    match /_connection_test_/{docId} {
      allow read: if true;
    }
  }
}
